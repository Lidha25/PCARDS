# Copy these settings into your private .env file or hosting secret settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
DATABASE_PATH=database/pcards.db
PORT=8000
# Streamlit Cloud: put these in private Secrets to preload a private GitHub database.
# Leave GITHUB_DATA_REPO blank to use DATABASE_PATH locally.
GITHUB_DATA_REPO=
GITHUB_DATA_FILE=pcards.db.gz
GITHUB_DATA_BRANCH=main
GITHUB_DATA_TOKEN=
